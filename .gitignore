# ==============================================================================
# CodeMate AI — Monorepo Production .gitignore
# Production-grade gitignore covering Extension, Frontend (Next.js), and FastAPI
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
extension/node_modules/
frontend/node_modules/
/.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 2. Production Build Outputs & Compilations
# ------------------------------------------------------------------------------
dist/
extension/dist/
dist-ssr/
build/
out/
frontend/.next/
frontend/out/
*.tsbuildinfo
*.zip
*.crx
*.xpi
codemate-phase0-poc/

# ------------------------------------------------------------------------------
# 3. Test Automation Scripts, Temp Profiles & Test Run Artifacts
# ------------------------------------------------------------------------------
backend/app/tests/
test/
tests/
.test-chrome-profile*
coverage/
.nyc_output/
test-results/
*_test_results.json
*.tmp
*.temp
tmp/
temp/

# ------------------------------------------------------------------------------
# 4. Runtime Logs & Debug Output
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. Environment Variables, Local Overrides & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
extension/.env
extension/.env.*
!extension/.env.example
*.pem
*.key

# ------------------------------------------------------------------------------
# 6. Bundler, Linter & Compiler Caches
# ------------------------------------------------------------------------------
.vite/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.vercel/

# ------------------------------------------------------------------------------
# 7. Editor & IDE Directories
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 8. Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 9. Python Virtual Environments, Bytecode & Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
env/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 10. SQLite Local Databases & WAL Logs
# ------------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
codemate.db*
backend/codemate.db*

# ------------------------------------------------------------------------------
# 11. Prompts, Scratch Notes & Specs
# ------------------------------------------------------------------------------
*_prompt.txt
*prompt*.txt
*.scratch
scratch/

# ------------------------------------------------------------------------------
# 12. Local Maintenance Scripts & Utilities (Non-production)
# ------------------------------------------------------------------------------
backend/scripts/

# ------------------------------------------------------------------------------
# 13. Internal Phase Documentation, Reports, Specs & Screenshots
# ------------------------------------------------------------------------------
docs/

# ------------------------------------------------------------------------------
# 14. Extension Test Automation & Debug Runner Scripts (Non-production)
# Retain only production build scripts; exclude dev/debug test runners
# ------------------------------------------------------------------------------
extension/scripts/*
!extension/scripts/build.cjs
!extension/scripts/generate-icons.cjs
scripts/*
!scripts/build.cjs
!scripts/generate-icons.cjs

backend/alembic/versions/8c937f1b2d4e_phase_8_schema.py

# ------------------------------------------------------------------------------
# 14. Extension Test Automation & Debug Runner Scripts (Non-production)
# Retain only production build scripts; exclude dev/debug test runners
# ------------------------------------------------------------------------------
extension/scripts/*
!extension/scripts/build.cjs
!extension/scripts/generate-icons.cjs
scripts/*
!scripts/build.cjs
!scripts/generate-icons.cjs

backend/alembic/versions/8c937f1b2d4e_phase_8_schema.py
