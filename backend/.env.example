# ==============================================================================
# CodeMate AI — Backend Environment Configuration Template (.env.example)
# Copy this file to .env and configure keys. NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Options: "development", "test", "production"
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# Security & CORS: Comma-separated domains allowed to connect to API
# In production, replace localhost with your actual domain and Chrome extension ID:
# e.g.: https://codemateai.com,https://app.codemateai.com,chrome-extension://YOUR_EXTENSION_ID
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,chrome-extension://*
MAX_REQUEST_SIZE_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------------------------------
# 2. AI PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Active AI provider: "deepseek", "gemini", "openai", "openrouter", "anthropic", or "xai"
AI_PROVIDER=deepseek

# [Provider 1] Google Gemini (Recommended & Default for Managed Tier):
# Get key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# [Provider 2] OpenAI (Optional):
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# [Provider 3] OpenRouter (Optional / Free Tier Models & BYOK):
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# [Provider 4] Anthropic Claude (Optional / BYOK):
# Get key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# [Provider 5] DeepSeek (Optional / BYOK):
# Get key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# [Provider 6] xAI Grok (Optional / BYOK):
# Get key from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2
XAI_BASE_URL=https://api.x.ai/v1

# AI Execution Parameters:
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_SECONDS=60.0
AI_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 3. DATABASE & PERSISTENCE (PostgreSQL for Production, SQLite for Local)
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./codemate.db
SYNC_DATABASE_URL=sqlite:///./codemate.db

# Production on Render / PostgreSQL:
# Render automatically provides DATABASE_URL in the format:
# postgres://user:password@host/database
# The backend automatically converts it to postgresql+asyncpg:// for async pooling.
# DATABASE_URL=postgresql+asyncpg://codemate:your_password@localhost:5432/codemate
# SYNC_DATABASE_URL=postgresql://codemate:your_password@localhost:5432/codemate

# PostgreSQL Pool Tuning (Ignored for SQLite):
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 3.1 EPHEMERAL WORKING MEMORY & CACHE (Upstash Redis)
# ------------------------------------------------------------------------------
# Standard Redis connection URL (TLS):
# REDIS_URL=rediss://default:your_token@your-endpoint.upstash.io:6379
#
# Upstash REST API (Serverless HTTP with 15-minute auto-expiring ephemeral context):
# UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT SECURITY (Argon2id + JWT)
# ------------------------------------------------------------------------------
# REQUIRED FOR PRODUCTION: Generate a high-entropy 256-bit secret key via:
# openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_string_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 / SIGN IN WITH GOOGLE (Optional)
# ------------------------------------------------------------------------------
# Get credentials from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Get API Keys from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
# (Use rzp_test_xxx for development; rzp_live_xxx for production)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Webhook Secret: Configured when adding webhook in Razorpay Dashboard
# URL: https://your-backend-domain.com/api/payments/webhook
# Secret: Choose a strong random string and paste here:
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 7. EMAIL & TRANSACTIONAL NOTIFICATIONS (Resend SMTP)
# ------------------------------------------------------------------------------
# Options: "mock" (prints verification links to console) or "smtp" / "resend" (dispatches live emails)
EMAIL_PROVIDER=resend

# Resend SMTP Configuration (https://resend.com/docs/send-with-smtp):
SMTP_HOST=smtp.resend.com
# Port 465 for SSL (recommended) or 587 for STARTTLS
SMTP_PORT=465
# Resend username is always "resend"
SMTP_USER=resend
# Resend API key generated at https://resend.com/api-keys (starts with "re_")
SMTP_PASSWORD=re_your_resend_api_key_here
# From address: Use "onboarding@resend.dev" for testing or your verified domain (e.g. noreply@yourdomain.com)
SMTP_FROM_EMAIL=onboarding@resend.dev
