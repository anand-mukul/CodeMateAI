{
  "manifest_version": 3,
  "name": "CodeMate AI — Your Intelligent Coding Companion",
  "short_name": "CodeMate AI",
  "version": "1.0.0",
  "description": "Smart coding assistant with verified Ace editor integration and one-click code insertion for CodeChef.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.codechef.com/*",
    "https://codechef.com/*",
    "https://*.codemateai.com/*",
    "https://*.onrender.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "codemate-ai@codemateai.com",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeMate AI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.codechef.com/*", "https://codechef.com/*"],
      "js": ["content-main.js"],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*.codechef.com/*", "https://codechef.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
