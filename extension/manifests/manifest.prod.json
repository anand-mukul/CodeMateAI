{
  "manifest_version": 3,
  "name": "CodeMate AI — Your Intelligent Coding Companion",
  "short_name": "CodeMate AI",
  "version": "1.0.0",
  "description": "Smart coding companion with verified in-editor integration, algorithmic practice hints, and smart clipboard tools for competitive programming on CodeChef.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.codechef.com/*",
    "https://codechef.com/*",
    "https://*.codemateai.com/*",
    "https://codemateai.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeMate AI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.codechef.com/*", "https://codechef.com/*"],
      "js": ["content-main.js"],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.codechef.com/*",
        "https://codechef.com/*",
        "https://*.codemateai.com/*",
        "https://codemateai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
